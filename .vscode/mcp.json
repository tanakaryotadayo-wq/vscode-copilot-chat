{
	"servers": {
		"vscode-playwright-mcp": {
			"type": "stdio",
			"command": "npm",
			// See https://github.com/microsoft/vscode/blob/main/test/mcp/README.md for supported arguments
			"args": [
				"run",
				"start-stdio",
				"--",
				"--extensionDevelopmentPath=${workspaceFolder}",
			],
			"cwd": "${workspaceFolder}/../vscode/test/mcp"
		},
		"fusion-gate": {
			"type": "stdio",
			"command": "/Users/ryyota/miniforge3/bin/python3",
			"args": [
				"/Users/ryyota/fusion-gate/integration/fusion_gate_mcp.py"
			],
			"env": {
				"PYTHONUNBUFFERED": "1",
				"PYTHONPATH": "/Users/ryyota/fusion-gate/gate:/Users/ryyota/fusion-gate/intelligence:/Users/ryyota/fusion-gate/integration",
				"EMBEDDING2_MODE": "local_ai"
			}
		},
		"fusion-orchestrator-v2": {
			"type": "stdio",
			"command": "bash",
			"args": ["start.sh"],
			"cwd": "${workspaceFolder}/fusion-copilot/mcp-server"
		}
	},
	"inputs": []
}
